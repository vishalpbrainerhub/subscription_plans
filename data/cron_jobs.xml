<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        
        <!-- Cron job for subscription expiry check -->
        <record id="cron_check_subscription_expiry" model="ir.cron">
            <field name="name">Check Subscription Expiry</field>
            <field name="model_id" ref="model_user_subscription"/>
            <field name="state">code</field>
            <field name="code">model.check_expired_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        
    </data>
</odoo>
