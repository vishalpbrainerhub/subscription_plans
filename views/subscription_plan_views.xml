<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Subscription Plan Tree View -->
    <record id="subscription_plan_tree_view" model="ir.ui.view">
        <field name="name">subscription.plan.tree</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <tree string="Subscription Plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="plan_type"/>
                <field name="price" widget="monetary" string="Monthly Price"/>
                <field name="billing_period"/>
                <field name="currency_id" invisible="1"/>
                <field name="max_private_decks"/>
                <field name="max_cards_per_deck"/>
                <field name="is_active"/>
                <field name="is_popular"/>
            </tree>
        </field>
    </record>
    
    <!-- Subscription Plan Form View -->
    <record id="subscription_plan_form_view" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <header>
                    <field name="is_active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="is_active" widget="boolean_toggle"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Plan Name"/>
                        </h1>
                        <h3>
                            <field name="short_description" placeholder="Short description"/>
                        </h3>
                    </div>
                    
                    <group>
                        <group name="basic_info">
                            <field name="code"/>
                            <field name="plan_type"/>
                            <field name="sequence"/>
                            <field name="is_popular"/>
                        </group>
                        <group name="pricing">
                            <field name="currency_id" invisible="1"/>
                            <field name="price" widget="monetary" string="Monthly Price"/>
                            <field name="yearly_price" widget="monetary"/>
                            <field name="billing_period"/>
                        </group>
                        <group name="display">
                            <field name="color" widget="color"/>
                            <field name="icon"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Detailed plan description..."/>
                        </page>
                        
                        <page string="Limitations">
                            <group>
                                <group name="deck_limits">
                                    <field name="max_private_decks"/>
                                    <field name="max_cards_per_deck"/>
                                </group>
                                <group name="access_rights">
                                    <field name="requires_registration"/>
                                    <field name="can_create_decks"/>
                                    <field name="can_access_public_decks"/>
                                    <field name="can_access_premium_content"/>
                                    <field name="can_use_ai_generation"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Features">
                            <field name="feature_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="icon"/>
                                    <field name="is_highlighted"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Subscription Plan Action -->
    <record id="subscription_plan_action" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription plan!
            </p>
            <p>
                Define subscription plans with different features and pricing to offer your users.
            </p>
        </field>
    </record>

</odoo>